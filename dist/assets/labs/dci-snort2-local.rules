alert icmp any any -> $HOME_NET any (msg:"DCI TEST ICMP echo request"; itype:8; sid:1000001; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET [5985,5986] (msg:"DCI HUNT internal SYN to remote-management-associated ports"; flags:S,CE; classtype:policy-violation; sid:1000002; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"DCI HUNT SMB2 named pipe samr opened"; flow:to_server,established; content:"|73 00 61 00 6d 00 72 00|"; nocase; classtype:attempted-recon; sid:1000003; rev:1;)
